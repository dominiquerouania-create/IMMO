# ─── Général ──────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
TZ_DEFAULT=Europe/Paris

# ─── Base de données (Supabase Postgres en prod) ──────────
DATABASE_URL=postgresql://kairos:kairos@localhost:5432/kairos
REDIS_URL=redis://localhost:6379

# ─── Authentification (utilisateur unique) ────────────────
# Seul cet email Google est autorisé à se connecter.
OWNER_EMAIL=vous@gmail.com
JWT_SECRET=change-me-with-64-random-chars
# Clé AES-256-GCM (32 octets en base64) pour chiffrer les tokens OAuth en base
ENCRYPTION_KEY=

# ─── Google (OAuth + Calendar + Gmail + Drive) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ─── Moteurs IA ───────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
SKYWORK_API_KEY=
SKYWORK_BASE_URL=https://api.skywork.ai/v1
SKYWORK_MODEL=
COPILOT_TENANT_ID=
COPILOT_CLIENT_ID=
COPILOT_CLIENT_SECRET=
# Point d'API Copilot (Microsoft Graph) — laisser vide pour la valeur par défaut
COPILOT_ENDPOINT=
# Runner Claude Code (service séparé exécutant le Claude Agent SDK en sandbox)
CLAUDE_CODE_RUNNER_URL=
CLAUDE_CODE_RUNNER_TOKEN=

# ─── WhatsApp Cloud API (Meta) ────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=33600000000
WHATSAPP_TEMPLATE_REMINDER=kairos_reminder
# Vérification du webhook (GET) et signature HMAC des appels Meta (POST)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── Stockage local des documents générés ────────────────
STORAGE_DIR=./storage

# ─── Front ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ─── Développement ────────────────────────────────────────
# Connexion sans Google (POST /api/auth/dev-login). Ignoré si NODE_ENV=production.
ALLOW_DEV_LOGIN=false
