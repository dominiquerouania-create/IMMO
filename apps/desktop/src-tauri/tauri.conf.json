{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairos",
  "version": "0.1.0",
  "identifier": "app.kairos.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @kairos/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "NEXT_OUTPUT=export pnpm --filter @kairos/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      { "title": "Kairos", "width": 1400, "height": 900, "minWidth": 900, "minHeight": 600, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.kairos.example.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": ["icons/icon.png"],
    "category": "Productivity"
  },
  "plugins": {}
}
